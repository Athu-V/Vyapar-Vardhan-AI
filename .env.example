# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so real keys never get committed.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Google Gemini (free tier) — the default provider
# ─────────────────────────────────────────────────────────────────────────────
# Free API key: https://aistudio.google.com/apikey

# Optional — overrides the development key shipped in ai-providers.js
# GEMINI_API_KEY=your_gemini_api_key_here

# IMPORTANT: the free quota is per project AND per model.
# gemini-3.6-flash allows only ~20 free requests/day, while the 2.5 Flash
# family allows roughly 1,500/day on the very same free key.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.5-flash-lite

# ─────────────────────────────────────────────────────────────────────────────
# 2. SambaNova (free tier, no credit card) — second link in the chain
# ─────────────────────────────────────────────────────────────────────────────
# Sign up and create a key: https://cloud.sambanova.ai/
# Set this and the chat keeps answering after Gemini's daily quota runs out.

# SAMBANOVA_API_KEY=your_sambanova_key_here
# SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
# SAMBANOVA_MODELS=meta-llama/Llama-3.1-70B-Instruct

# Any other OpenAI-compatible service works the same way:
# OPENAI_COMPAT_API_KEY=...
# OPENAI_COMPAT_BASE_URL=https://your-endpoint/v1
# OPENAI_COMPAT_MODELS=model-name-one,model-name-two

# ─────────────────────────────────────────────────────────────────────────────
# 3. Local Ollama — unlimited and free, no quota, works offline
# ─────────────────────────────────────────────────────────────────────────────
# Install from https://ollama.com, then:  ollama pull gemma3:4b
# Leave these commented out to auto-detect: the chain reads whatever models the
# local Ollama instance actually has. Not running is fine — it is skipped.

# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_ENABLED=false          # set to false to remove Ollama from the chain

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
# Optional — port the static server listens on (default 3000).
# PORT=3000

# Optional — per-attempt timeout for AI calls, in milliseconds (default 45000).
# AI_REQUEST_TIMEOUT_MS=45000

# Optional — timeout for the local Ollama provider, in milliseconds
# (default 180000). Local models on CPU are slow, so they get far more room.
# OLLAMA_TIMEOUT_MS=180000

# ─────────────────────────────────────────────────────────────────────────────
# 4. Firebase (Authentication + Cloud Firestore + Cloud Storage)
# ─────────────────────────────────────────────────────────────────────────────
# Get these values from Firebase Console -> Project Settings -> General -> Your apps (Web)
# 1. Go to https://console.firebase.google.com/
# 2. Select or create your Firebase project
# 3. Enable Authentication (Sign-in methods: Google, Email/Password, Phone)
# 4. Enable Cloud Firestore database (Start in test mode or production rules)
# 5. Under Project Settings -> Your apps -> Web app (</>), copy the firebaseConfig:
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: Firebase App Check (reCAPTCHA v3 site key from Google reCAPTCHA Console)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key



